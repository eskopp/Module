---
import { getCollection } from 'astro:content';

const dir = Astro.url.pathname.replace(/^\/|\/$/g, '');
const entries = (await getCollection('docs'))
	.filter((e) => e.id.startsWith(`${dir}/`) && e.id.slice(dir.length + 1).indexOf('/') === -1)
	.sort((a, b) => a.id.localeCompare(b.id, 'de', { numeric: true }));

const statusLabel = { offen: 'offen', 'in-arbeit': 'in Arbeit', abgegeben: 'abgegeben' } as const;
const fmt = new Intl.DateTimeFormat('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'UTC' });
---

{
	entries.length === 0 ? (
		<p>Noch keine Einträge.</p>
	) : (
		<table>
			<thead>
				<tr>
					<th>Titel</th>
					<th>Abgabe</th>
					<th>Status</th>
				</tr>
			</thead>
			<tbody>
				{entries.map((e) => (
					<tr>
						<td>
							<a href={`/${e.id}/`}>{e.data.title}</a>
						</td>
						<td>{e.data.abgabe ? fmt.format(e.data.abgabe) : ''}</td>
						<td>{e.data.status ? statusLabel[e.data.status] : ''}</td>
					</tr>
				))}
			</tbody>
		</table>
	)
}
